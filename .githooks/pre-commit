#!/usr/bin/env bash
# Secret-scanning pre-commit hook.
#
# Rationale: .agent/decisions/0014-credentials-removed.md — Antelope/iLok OAuth2 token
# blobs once sat at the repository root, where `git add -A` would have swept them up.
#
# Detection is deliberately value-based, not word-based. An earlier version matched bare
# occurrences of "access_token", which flagged the ADR that *describes* the incident and
# the hook's own pattern list, blocking legitimate commits. A secret is a key followed by
# an assignment and a long opaque value, so that is what this looks for.
#
# CI runs this same file over a pull request or a push (.github/workflows/ci.yml):
#
#     .githooks/pre-commit --range <base>      scan what changed from <base> to HEAD,
#                                              reading each file as HEAD has it
#
# With no arguments, as git runs it, it scans the staged files as they are staged.
set -u

fail=0
if [ "${1:-}" = "--range" ]; then
    base=${2:?"--range needs a base commit"}
    staged=$(git diff --name-only --diff-filter=ACM "$base" HEAD) || exit 2
    show() { git show "HEAD:$1"; }
else
    staged=$(git diff --cached --name-only --diff-filter=ACM)
    show() { git show ":$1"; }
fi
[ -z "$staged" ] && exit 0

# --- 1. Files that must never be committed, by name ------------------------------------
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$(basename "$f")" in
        herd|ilok|.env|credentials.json|*.pem|*.key|id_rsa|id_ed25519)
            echo "BLOCKED: '$f' is a credential file and must not be committed." >&2
            fail=1 ;;
    esac
done <<< "$staged"

# --- 2. Unambiguous credential formats --------------------------------------------------
# These never appear legitimately, so a bare match is enough.
HARD='(BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9A-Za-z-]{10,}|gh[pousr]_[0-9A-Za-z]{36})'

# --- 3. key = <long opaque value> -------------------------------------------------------
# Requires an assignment and a value of 16+ credential-ish characters, so prose such as
# "the file holds an access_token" does not match, while `access_token = "AbCd..."` does.
SOFT='(access_token|refresh_token|client_secret|api[_-]?key|secret_key|password|passwd)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9/+_.~-]{16,}'

while IFS= read -r f; do
    [ -z "$f" ] && continue
    [ -f "$f" ] || continue
    # The hook necessarily contains its own patterns.
    [ "$f" = ".githooks/pre-commit" ] && continue
    show "$f" 2>/dev/null | grep -Iq . || continue          # skip binaries

    hits=$(show "$f" 2>/dev/null | grep -nEI "$HARD" | head -3)
    if [ -n "$hits" ]; then
        echo "BLOCKED: '$f' contains what looks like a credential:" >&2
        echo "$hits" | sed 's/^/    /' >&2
        fail=1
        continue
    fi
    hits=$(show "$f" 2>/dev/null | grep -nEI "$SOFT" | head -3)
    if [ -n "$hits" ]; then
        echo "BLOCKED: '$f' assigns a value to a credential-like name:" >&2
        echo "$hits" | sed 's/^/    /' >&2
        fail=1
    fi
done <<< "$staged"

if [ "$fail" -ne 0 ]; then
    echo >&2
    if [ "${1:-}" = "--range" ]; then
        echo "The change adds what looks like a secret. Remove it from the history, and revoke it if it was real." >&2
    else
        echo "Commit aborted. Remove the secret, or use --no-verify if this is a false positive." >&2
    fi
    exit 1
fi
exit 0
