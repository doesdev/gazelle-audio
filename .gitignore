# --- Rust ---
/target/
**/*.rs.bk

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Vendor-derived material ---
# Antelope's binaries and anything decompiled from them stay local. The publishable
# artifacts are the protocol spec, the tooling, and our Rust implementation, so that
# anyone can regenerate these from their own copy of the Antelope software
# (docs/reverse-engineering.md).
/refs/bin/
/refs/extracted/
/refs/decompiled/

# Third-party tools. Kept locally for convenience, never redistributed here:
# pyinstxtractor is GPL-3.0 and this repository is MIT, so vendoring it would put the
# tree under conflicting terms. Install it from upstream instead, as
# docs/reverse-engineering.md describes. pycdc is a separate C++ checkout.
/refs/tools/pyinstxtractor.py
/refs/tools/PYINSTXTRACTOR-LICENSE
/refs/tools/PYINSTXTRACTOR-README.md
/refs/tools/pycdc/

# --- Secrets ---
# Credential and key files never belong in the tree (.githooks/pre-commit also scans for them).
herd
ilok
*.pem
*.key
.env
.env.*
!.env.example
credentials.json
secrets.*

# --- Web workspace build output and dependencies. ---
# Phase 3 builds the web UI into web/apps/web/dist, which the server embeds; neither the
# build output nor node_modules belongs in the tree.
web/**/dist/
web/**/node_modules/
# Playwright output: traces, failure screenshots and the design-review screenshots.
web/test-results/
web/playwright-report/

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Agent worktrees: checkouts of this repo, never content of it.
.claude/worktrees/
# Local editor/agent launch settings hold machine-specific paths.
.claude/launch.json

# The project's working notes (status, decisions, specs, reference) live in a separate
# private repository that may be checked out here. Nothing in this tree depends on it.
/.agent/

# --- Docs build output (pnpm -C web docs). The PDFs are built, never committed. ---
/docs/dist/
*.pdf
