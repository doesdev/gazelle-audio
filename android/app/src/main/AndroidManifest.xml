<?xml version="1.0" encoding="utf-8"?>
<!--
  Gazelle Remote: a full screen WebView of the Gazelle on the owner's computer, and pairing by
  scanning its QR code.

  Permissions: the network only. Scanning goes through Google Play services' code scanner, which
  shows its own camera screen and hands back the text, so this app needs no camera permission.

  allowBackup is off: the app holds the phone's key to Gazelle (in the WebView's cookie jar), and
  that belongs on this phone, not in a cloud backup.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GazelleRemote">

        <!-- Ask Play services for the scanner module when the app is installed, not on first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on the app's icon offers "Pair with another computer". -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
