<?xml version="1.0" encoding="utf-8"?>
<!--
  The "G" of the desktop icon (crates/gazelle-audio-server/src/icon.rs), as a vector: a ring from
  radius 0.40 to 0.66 of the icon, open between 0 and 60 degrees on the upper right, and a bar from
  x 0.05 to 0.66 and y -0.06 to 0.12, in units where the desktop disc has radius 0.97.

  Here that disc is the launcher's mask, taken as 72dp across the 108dp canvas, so one unit is
  36 / 0.97 dp about the centre (54, 54), y pointing down. The whole mark sits inside the 66dp
  circle every launcher mask keeps.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/icon_mark"
        android:pathData="M66.247,32.787 A24.495,24.495 0 1,0 78.495,54 L68.845,54 A14.845,14.845 0 1,1 61.423,41.144 Z" />
    <path
        android:fillColor="@color/icon_mark"
        android:pathData="M55.856,49.546 H78.495 V56.227 H55.856 Z" />
</vector>
