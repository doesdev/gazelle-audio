<?xml version="1.0" encoding="utf-8"?>
<!--
  A button as the web app draws one (web/apps/web/src/elements/styles.ts): flat, the control
  colour, a subtle border and the field radius (3px), darker when pressed, and the focus colour
  round it when a keyboard has focused it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_disabled" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_active" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/control_hover" />
            <stroke android:width="2dp" android:color="@color/focus" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/control_background" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
